{
  "manifest_version": 3,
  "name": "Sổ Từ",
  "version": "0.3.0",
  "description": "Double-click từ, cụm từ hoặc đoạn văn chưa hiểu để lưu kèm ngữ cảnh. Sau đó AI giải thích một lượt và xuất sang Anki.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sổ Từ"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting", "alarms"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "save-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Lưu phần đang bôi đen vào Sổ Từ"
    }
  }
}
